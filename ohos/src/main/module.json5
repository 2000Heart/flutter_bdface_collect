{
  "module": {
    "name": "flutter_bdface_collect_plus",
    "type": "har",
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:camera_permission_reason",
        "usedScene": {
          "when": "inuse"
        }
      }
    ]
  }
}
